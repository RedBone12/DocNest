        <dependency><groupId>com.priyanshu.documents.common</groupId><artifactId>common-events</artifactId><version>1.0-SNAPSHOT</version></dependency>
        <dependency><groupId>com.priyanshu.documents</groupId><artifactId>e2e-tests</artifactId><version>1.0-SNAPSHOT</version><scope>test</scope></dependency>
    </dependencies>
    <build><plugins><plugin>
        <groupId>org.jacoco</groupId><artifactId>jacoco-maven-plugin</artifactId><version>0.8.14</version>
        <executions><execution><id>aggregate</id><phase>verify</phase><goals><goal>report-aggregate</goal></goals></execution></executions>
    </plugin></plugins></build>
</project>
