POSTGRES_DB=documents_db
POSTGRES_USER=doc_user
POSTGRES_PASSWORD=replace-with-your-database-password
MINIO_ROOT_USER=docnest_admin
MINIO_ROOT_PASSWORD=replace-with-your-minio-password
MINIO_BUCKET=documents
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# Optional: leave empty to index/search documents without AI analysis.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional email delivery for password recovery. Never commit real SMTP credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
SMTP_AUTH=true
# Set true for implicit TLS on port 465 (for example, 163 Mail).
SMTP_SSL=false
SMTP_STARTTLS=true
FRONTEND_URL=http://localhost:5173
# Public browser origins accepted by the gateway. Use exact HTTPS origins in production.
CORS_ALLOWED_ORIGINS=http://localhost:[*],http://127.0.0.1:[*]
